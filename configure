#!/bin/sh

if [ $# != 1 ];then
    echo "usage: `basename $0` <personalize-data-dir>" >&2
    exit 1
fi

# if ! node --version > /dev/null 2>&1;then
#     echo "node.js must be installed before running configure script" >&2
#     exit 1
# fi

BASEDIR="$1"
TYPE=`tool/extjson $BASEDIR/wakeserver.conf server_type`
# NODEDIR=`npm bin -g`

if [ `cut -d. -f1 /etc/debian_version` -gt 11 ];then
    PIPOPT=--break-system-packages
fi

if [ "$TYPE" = "" ];then
    TYPE=master
fi

if [ "$TYPE" = master ];then
    echo "PERSONAL       = $BASEDIR"
    # echo "INSTALL_TARGET = pythonpackage apache2restart daemonrestart \\"
    # echo "                 avahirestart homebridgerestart mqttrestart"
    echo "INSTALL_TARGET = pythonpackage daemonrestart \\"
    echo "                 avahirestart mqttrestart"
    echo "SERVICE_NAME   = _wakeserver._tcp"
    echo "SERVICE_PORT   = 8080"
    echo "HOMEBRIDGE     = $NODEDIR/homebridge"
    echo "PIPOPT         = $PIPOPT"
else
    echo "PERSONAL       = $BASEDIR"
    echo "INSTALL_TARGET = daemonrestart avahirestart pythonpackage"
    echo "SERVICE_NAME   = _wakeserver_slave._tcp"
    echo "SERVICE_PORT   = 8081"
    echo "PIPOPT         = $PIPOPT"
fi > .config.mk
